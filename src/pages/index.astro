
---
import MainLayout from "../layouts/MainLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    number: "01",
    title: "Satellite Data Platform",
    description:
      "A platform for processing, organizing and accessing satellite data and products.",
    technologies: ["C#", "Angular", "Docker"],
  },
  {
    number: "02",
    title: "Ground Segment Automation",
    description:
      "Tools and automation designed to improve operational workflows and system reliability.",
    technologies: ["Python", "Bash", "Linux"],
  },
  {
    number: "03",
    title: "Personal Projects",
    description:
      "A collection of experiments, engineering ideas and software projects.",
    technologies: ["TypeScript", "Python", "APIs"],
  },
];
---

<MainLayout
  title="Andoni Alcelay | Software Engineer"
  description="Software engineer focused on backend development, automation and complex systems."
>
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute right-[-10rem] top-[-12rem] h-[32rem] w-[32rem] rounded-full bg-cyan-400/[0.08] blur-3xl"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    </div>

    <div class="mx-auto grid min-h-[78vh] max-w-6xl items-center gap-12 px-6 py-24 md:grid-cols-[1.4fr_0.6fr] md:py-32">
      <div>
        <p class="mb-6 flex items-center gap-3 text-sm text-cyan-300">
          <span class="h-px w-8 bg-cyan-300"></span>
          SOFTWARE ENGINEER · GERMANY
        </p>

        <h1 class="max-w-3xl text-5xl font-semibold leading-[1.08] tracking-tight text-white sm:text-7xl">
          Building software
          <span class="text-slate-500">for complex systems.</span>
        </h1>

        <p class="mt-8 max-w-xl text-base leading-8 text-slate-400 sm:text-lg">
          I'm Andoni, a software engineer working across backend development,
          automation and technology for the space sector.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/projects"
            class="rounded-lg bg-cyan-300 px-5 py-3 text-sm font-semibold text-slate-950 hover:bg-cyan-200"
          >
            Explore my work ↗
          </a>
          <a
            href="/contact"
            class="rounded-lg border border-white/15 px-5 py-3 text-sm font-medium text-white hover:border-white/40"
          >
            Get in touch
          </a>
        </div>

        <div class="mt-12 flex flex-wrap gap-x-6 gap-y-3 text-sm text-slate-500">
          <span>Backend engineering</span>
          <span>Automation</span>
          <span>Space systems</span>
        </div>
      </div>

      <div class="hidden md:block">
        <div class="relative mx-auto flex aspect-square max-w-xs items-center justify-center rounded-full border border-cyan-300/20">
          <div class="absolute inset-5 rounded-full border border-white/10"></div>
          <div class="absolute inset-12 rounded-full border border-dashed border-white/15"></div>
          <div class="absolute right-[18%] top-[22%] h-3 w-3 rounded-full bg-cyan-300 shadow-[0_0_24px_6px_rgba(103,232,249,0.3)]"></div>
          <span class="font-mono text-7xl font-light tracking-tighter text-white/90">AA<span class="text-cyan-300">.</span></span>
          <span class="absolute bottom-8 font-mono text-[10px] tracking-[0.3em] text-slate-500">ENGINEERING / SYSTEMS</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-3 font-mono text-xs tracking-widest text-cyan-300">SELECTED WORK</p>
        <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Projects & engineering</h2>
      </div>
      <a href="/projects" class="text-sm text-slate-400 hover:text-cyan-300">
        All projects ↗
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-28">
    <div class="rounded-2xl border border-white/10 bg-white/[0.025] p-8 sm:p-12">
      <p class="mb-4 font-mono text-xs tracking-widest text-cyan-300">LET'S CONNECT</p>
      <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
        <h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-white sm:text-5xl">
          Have an interesting project in mind?
        </h2>
        <a href="/contact" class="shrink-0 text-sm font-medium text-cyan-300 hover:text-white">
          Get in touch ↗
        </a>
      </div>
    </div>
  </section>
</MainLayout>
