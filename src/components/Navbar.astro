
---
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#080d17]/90 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="/" class="text-lg font-semibold tracking-tight text-white">
      AA<span class="text-cyan-300">.</span>
    </a>

    <div class="flex items-center gap-4 sm:gap-7">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? "page" : undefined}
          class:list={[
            "text-xs transition-colors sm:text-sm",
            currentPath === link.href
              ? "text-cyan-300"
              : "text-slate-400 hover:text-white",
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>
