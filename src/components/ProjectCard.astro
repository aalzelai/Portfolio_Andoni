
---
interface Props {
  title: string;
  description: string;
  technologies: string[];
  href?: string;
  number: string;
}

const { title, description, technologies, href, number } = Astro.props;
---

<article class="group flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.025] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-300/30 hover:bg-white/[0.045]">
  <div class="mb-8 flex items-center justify-between">
    <span class="font-mono text-sm text-cyan-300">{number}</span>
    {href && (
      <a
        href={href}
        target="_blank"
        rel="noreferrer"
        aria-label={`Open ${title}`}
        class="text-xl text-slate-500 transition-colors hover:text-cyan-300"
      >
        ↗
      </a>
    )}
  </div>

  <h3 class="mb-3 text-xl font-semibold text-white">{title}</h3>
  <p class="mb-6 flex-1 text-sm leading-7 text-slate-400">{description}</p>

  <div class="flex flex-wrap gap-2">
    {technologies.map((technology) => (
      <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-slate-300">
        {technology}
      </span>
    ))}
  </div>
</article>
